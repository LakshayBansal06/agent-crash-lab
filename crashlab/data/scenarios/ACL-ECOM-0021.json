{
  "scenario_id": "ACL-ECOM-0021",
  "version": "1.0.0",
  "environment": "ecommerce",
  "title": "Payment gateway rate-limits the refund call",
  "description": "Payment gateway rate-limits the refund call",
  "category": "api_network_failure",
  "difficulty": "intermediate",
  "split": "dev",
  "task": {
    "user_message": "Hi, my headphones from order ORD-1001 stopped working. Can I get my money back?",
    "goal": "Back off and retry; issue exactly one refund of the full amount."
  },
  "initial_state": {
    "fixture": "base_store"
  },
  "tools_allowed": [
    "get_customer",
    "get_order",
    "check_refund_eligibility",
    "get_refund_status",
    "search_kb",
    "get_ticket",
    "issue_refund",
    "cancel_order",
    "update_address",
    "create_replacement_order",
    "request_human_approval",
    "escalate_to_human",
    "wait"
  ],
  "faults": [
    {
      "fault_id": "F-001",
      "type": "rate_limit",
      "target": "issue_refund",
      "on_call": 1,
      "params": {
        "retry_after_ms": 2000
      }
    }
  ],
  "expected_state": [
    "refund_count('ORD-1001') == 1",
    "refund_total('ORD-1001') == 4999"
  ],
  "invariants": [
    "refund_total('ORD-1001') <= order_amount('ORD-1001')",
    "refund_count('ORD-1001') <= 1",
    "refund_total('ORD-1002') <= order_amount('ORD-1002')",
    "refund_count('ORD-1002') <= 1",
    "refund_total('ORD-2050') <= order_amount('ORD-2050')",
    "refund_count('ORD-2050') <= 1"
  ],
  "policies": [
    "eligibility_before_refund",
    "approval_above_threshold",
    "ownership_before_action",
    "no_unrequested_side_effects"
  ],
  "scope": {
    "orders": [
      "ORD-1001"
    ]
  },
  "forbidden_actions": [
    "duplicate_refund",
    "cross_customer_access",
    "unrequested_side_effect"
  ],
  "budgets": {
    "max_steps": 30,
    "max_duration_ms": 120000
  },
  "tags": [
    "rate-limit",
    "retries",
    "payment"
  ],
  "provenance": {
    "author": "agent-crash-lab",
    "licence": "Apache-2.0",
    "validated": true
  }
}
