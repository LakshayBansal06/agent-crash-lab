{
  "scenario_id": "ACL-ECOM-0020",
  "version": "1.0.0",
  "environment": "ecommerce",
  "title": "Cancellation times out after committing",
  "description": "Cancellation times out after committing",
  "category": "recovery_rollback",
  "difficulty": "intermediate",
  "split": "validation",
  "task": {
    "user_message": "Cancel ORD-1002 and refund it, please.",
    "goal": "Verify the cancellation, then refund once."
  },
  "initial_state": {
    "fixture": "base_store"
  },
  "tools_allowed": [
    "get_customer",
    "get_order",
    "check_refund_eligibility",
    "get_refund_status",
    "search_kb",
    "get_ticket",
    "issue_refund",
    "cancel_order",
    "update_address",
    "create_replacement_order",
    "request_human_approval",
    "escalate_to_human",
    "wait"
  ],
  "faults": [
    {
      "fault_id": "F-001",
      "type": "timeout_after_commit",
      "target": "cancel_order",
      "on_call": 1,
      "delay_ms": 12000
    }
  ],
  "expected_state": [
    "order_status('ORD-1002') == 'CANCELLED'",
    "refund_count('ORD-1002') == 1"
  ],
  "invariants": [
    "refund_total('ORD-1001') <= order_amount('ORD-1001')",
    "refund_count('ORD-1001') <= 1",
    "refund_total('ORD-1002') <= order_amount('ORD-1002')",
    "refund_count('ORD-1002') <= 1",
    "refund_total('ORD-2050') <= order_amount('ORD-2050')",
    "refund_count('ORD-2050') <= 1"
  ],
  "policies": [
    "eligibility_before_refund",
    "approval_above_threshold",
    "ownership_before_action",
    "no_unrequested_side_effects"
  ],
  "scope": {
    "orders": [
      "ORD-1002"
    ]
  },
  "forbidden_actions": [
    "duplicate_refund",
    "cross_customer_access",
    "unrequested_side_effect"
  ],
  "budgets": {
    "max_steps": 30,
    "max_duration_ms": 120000
  },
  "tags": [
    "idempotent-write",
    "recovery"
  ],
  "provenance": {
    "author": "agent-crash-lab",
    "licence": "Apache-2.0",
    "validated": true
  }
}
