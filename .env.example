# Copy to .env (git-ignored). Never commit real values.
CRASHLAB_DB=/data/crashlab.db
# required = sign in (or an API key) for the dashboard and API (default). "off" is only allowed on 127.0.0.1.
CRASHLAB_AUTH=required
CRASHLAB_WORKERS=2
CRASHLAB_MAX_RUNNING=4
# Exact origins allowed to call the API from a browser. Empty = same-origin only. "*" is refused.
CRASHLAB_CORS=
# Per key (or per IP when unauthenticated), per minute
CRASHLAB_RATE_READ_PER_MIN=300
CRASHLAB_RATE_WRITE_PER_MIN=60
CRASHLAB_RATE_EXPENSIVE_PER_MIN=10
CRASHLAB_MAX_BODY_BYTES=5242880
# Optional: enables the built-in LLM agent. Server-side only; never sent to the browser.
ANTHROPIC_API_KEY=
CRASHLAB_MODEL=claude-sonnet-5-5

# ---- Public website (all optional; each feature turns itself off when blank)
# Your domain, for HTTPS (Caddy), canonical URLs, sitemap.xml and share previews
CRASHLAB_DOMAIN=
CRASHLAB_PUBLIC_URL=
# Send HSTS (browsers will only use https). Set to 1 only once HTTPS works.
CRASHLAB_HSTS=0
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after a visitor accepts cookies.
CRASHLAB_GA_ID=
# Cloudflare Turnstile keys for contact-form spam protection (dash.cloudflare.com -> Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shown in the privacy policy
CRASHLAB_OPERATOR=
CRASHLAB_CONTACT_EMAIL=
# Keeps contact-form tokens valid across restarts (any long random string)
CRASHLAB_FORM_SECRET=
CRASHLAB_RATE_CONTACT_PER_MIN=5

# ---- Accounts and sign-in (all optional)
# "Continue with Google": create an OAuth client at console.cloud.google.com (see docs/HOW-TO-RUN.md, section O)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts with these emails become admins when they sign in (comma separated)
CRASHLAB_ADMIN_EMAILS=
# Password-reset emails. Without these, admins create reset links from the admin console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Gemini test agent (optional). Server-side only; never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Real-model spend (Claude/Gemini use the server's API credit; only admins can run them)
CRASHLAB_MODEL_EPISODES_PER_RUN=60
CRASHLAB_MODEL_EPISODES_PER_DAY=200

# ---- Behind a reverse proxy (Render: 1). Rate limits then use the client IP the proxy appended
# (right-most X-Forwarded-For), never the left-most one a visitor can forge. Leave 0 when not proxied.
CRASHLAB_PROXY_HOPS=0
